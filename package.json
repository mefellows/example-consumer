{
  "name": "consumer",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "axios": "^0.27.2"
  },
  "scripts": {
    "test": "cross-env CI=true npx jest --colors --testTimeout 30000 --testMatch \"**/*.spec.ts\"",
    "test:pact": "cross-env CI=true npx jest --colors --testTimeout 30000 --testMatch \"**/*.pact.spec.js\"",
    "pact:publish": "pact-broker publish ./pacts --consumer-app-version=$npm_package_version --broker-base-url=$PACT_BROKER_BASE_URL --broker-token=$PACT_BROKER_TOKEN"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "@pact-foundation/pact": "^12.1.0",
    "@pact-foundation/pact-cli": "^15.0.4"
  }
}