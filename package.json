{
  "name": "consumer",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "axios": "^0.27.2"
  },
  "scripts": {
    "test": "cross-env CI=true npx jest --colors --testTimeout 30000 --testMatch \"**/*.spec.ts\"",
    "test:pact": "jest --testMatch='**/*.pact.spec.ts'",
    "test:pact:verbose": "jest --testMatch='**/*.pact.spec.ts' --verbose",
    "pact:publish": "pact-broker publish pacts --consumer-app-version=$GITHUB_SHA --broker-base-url=$PACT_BROKER_BASE_URL --broker-token=$PACT_BROKER_TOKEN",
    "pact:verify": "pact-broker can-i-deploy --consumer=ProductConsumer --version=$GITHUB_SHA --broker-base-url=$PACT_BROKER_BASE_URL --broker-token=$PACT_BROKER_TOKEN"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^29.5.12",
    "@pact-foundation/pact": "^12.0.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "typescript": "^5.0.0",
    "ts-jest": "^29.1.0"
  }
}